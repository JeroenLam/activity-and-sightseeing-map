# Backend
SECRET_KEY=change-me-to-a-random-secret
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
JWT_EXPIRY_DAYS=7

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:80

# Google OAuth (optional — leave empty to hide OAuth buttons)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_CALLBACK_URL=http://localhost:8000/api/auth/google/callback

# Geocoding
NOMINATIM_USER_AGENT=activity-map-app
NOMINATIM_RATE_LIMIT=1.0
